generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Game {
  id        String   @id @default(uuid())
  date      String
  time      String
  field     String
  team      String
  opponent  String
  status    String

  teamScore     Int?
  opponentScore Int?

  createdAt DateTime @default(now())
}

model Team {
  id        String   @id @default(uuid())
  name      String   @unique
  shieldUrl String?
  createdAt DateTime @default(now())
}